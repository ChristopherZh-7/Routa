{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "routa",
  "version": "0.8.6",
  "identifier": "dev.routa",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-procsvc.mjs && node scripts/build-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Routa",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2QzIyQTJENTgyNDMwRjYKUldUMk1DUllMU3JDUnV5b3pvK1VVTGZZdmxQS1VNM3ZPNTFaOXhNVXdpZzkzM0J1QUtNbmYvQ0YK",
      "endpoints": [
        "https://gh-proxy.org/https://github.com/ChristopherZh-7/Routa/releases/latest/download/latest-proxy.json",
        "https://ghfast.top/https://github.com/ChristopherZh-7/Routa/releases/latest/download/latest-proxy.json",
        "https://github.com/ChristopherZh-7/Routa/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/mihomo", "binaries/routa-procsvc"],
    "resources": { "binaries/procsvc/*": "procsvc/" },
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installerHooks": "nsis/hooks.nsh" }
    }
  }
}
